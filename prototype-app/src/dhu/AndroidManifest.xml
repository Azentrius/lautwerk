<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="com.openai.chatgpt" />
        <package android:name="com.anthropic.claude" />
    </queries>
    <application>
        <meta-data android:name="com.azentrius.lautwerk.car.HANDOFF_EXPERIMENT"
            android:value="${carHandoffExperiment}" />
        <meta-data android:name="com.azentrius.lautwerk.car.HANDOFF_ENTRY"
            android:value="${carHandoffEntry}" />
        <meta-data android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data android:name="androidx.car.app.minCarApiLevel" android:value="1" />
        <meta-data android:name="androidx.car.app.theme" android:resource="@style/CarAppTheme" />
        <service android:name="com.azentrius.lautwerk.car.LautwerkCarService"
            android:exported="true" android:label="@string/app_name">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <!-- DEBUG-ONLY template discovery probe. Lautwerk is NOT a POI
                     application. This does not establish category eligibility,
                     Play approval, or permission to run in real vehicles.
                     No general AI-assistant category is claimed or invented. -->
                <category android:name="androidx.car.app.category.POI" />
            </intent-filter>
        </service>
    </application>
</manifest>
