<resources>
    <style name="Theme.OpenAutoAI.Base" parent="Theme.OpenAutoAI.Palette">
        <item name="android:fontFamily">@font/dm_sans_regular</item>
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="android:statusBarColor">@color/az_bg_page</item>
        <item name="android:navigationBarColor">@color/az_bg_page</item>
    </style>
    <style name="Theme.OpenAutoAI" parent="Theme.OpenAutoAI.Base" />
    <style name="AzBody">
        <item name="android:textSize">15sp</item>
        <item name="android:lineHeight">22sp</item>
        <item name="android:fontFamily">@font/dm_sans_regular</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:hyphenationFrequency">none</item>
        <item name="android:textColor">@color/az_text_subtle</item>
    </style>
    <style name="AzLabel" parent="AzBody">
        <item name="android:textSize">13sp</item>
        <item name="android:lineHeight">18sp</item>
        <item name="android:fontFamily">@font/dm_sans_medium</item>
    </style>
</resources>
