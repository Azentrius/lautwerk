<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:fillViewport="true"
    android:background="#101C24">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_vertical" android:padding="28dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textSize="34sp" android:textStyle="bold"
            android:textColor="#F3F9FC" android:accessibilityHeading="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/prototype_note"
            android:textSize="18sp" android:textColor="#CBD9E2" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/provider_label"
            android:labelFor="@id/provider" android:textSize="16sp" android:textColor="#CBD9E2" />
        <Spinner android:id="@+id/provider" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="56dp"
            android:spinnerMode="dropdown" android:saveEnabled="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/model_label"
            android:labelFor="@id/model" android:textSize="16sp" android:textColor="#CBD9E2" />
        <Spinner android:id="@+id/model" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="56dp"
            android:spinnerMode="dropdown" android:saveEnabled="false" />
        <TextView android:id="@+id/selection_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:textSize="14sp" android:textColor="#A6BAC8"
            android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="32dp"
            android:text="@string/ready" android:textSize="22sp" android:textColor="#63DDC1"
            android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/start" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="56dp"
            android:layout_marginTop="20dp" android:text="@string/start"
            android:textAllCaps="false" android:textSize="20sp"
            android:backgroundTint="#63DDC1" android:textColor="#10232C" />
        <TextView android:id="@+id/variant_note" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="28dp"
            android:textSize="14sp" android:textColor="#A6BAC8" />
    </LinearLayout>
</ScrollView>
