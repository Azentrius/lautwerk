<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <meta-data android:name="com.azentrius.lautwerk.car.NATIVE_CONTROLS" android:value="${nativeControlsExperiment}" />
        <activity android:name="com.azentrius.lautwerk.car.controls.NativeControlSetupActivity"
            android:enabled="${nativeControlsExperiment}" android:exported="true"
            android:label="@string/native_control_title" />
        <service android:name="com.azentrius.lautwerk.car.controls.ControlVoiceInteractionService"
            android:enabled="${nativeControlsExperiment}" android:exported="true"
            android:label="@string/native_control_title" android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter><action android:name="android.service.voice.VoiceInteractionService" /></intent-filter>
            <meta-data android:name="android.voice_interaction" android:resource="@xml/native_voice_interaction" />
        </service>
        <service android:name="com.azentrius.lautwerk.car.controls.ControlVoiceSessionService"
            android:enabled="${nativeControlsExperiment}" android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <service android:name="com.azentrius.lautwerk.car.controls.ControlRecognitionService"
            android:enabled="${nativeControlsExperiment}" android:exported="true"
            android:permission="android.permission.BIND_SPEECH_RECOGNITION_SERVICE">
            <intent-filter><action android:name="android.speech.RecognitionService" /></intent-filter>
        </service>
        <service android:name="com.azentrius.lautwerk.car.controls.NativeControlListener"
            android:enabled="${nativeControlsExperiment}" android:exported="true"
            android:label="@string/native_control_title" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>
    </application>
</manifest>
